# Frontend (Vite expõe qualquer variável prefixada com VITE_ no bundle do navegador).
# As chaves do Firebase Web SDK não são segredos — a proteção real vem das
# Firestore Security Rules (firestore.rules) + do custom token emitido pelo backend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend (Vercel Serverless Functions em /api). NUNCA prefixar com VITE_ —
# essas variáveis nunca devem chegar ao navegador.

# Hash bcrypt da sua senha de acesso. Gere com: node scripts/gerar-hash-senha.js "sua senha"
# IMPORTANTE pro .env local: escape cada "$" do hash com "\$" (ex.: \$2b\$12\$...).
# O loadEnv do Vite interpola "$nomeComLetra" como se fosse variável de ambiente e
# corta parte do hash silenciosamente se não escapar — só afeta o dev local, a
# Vercel injeta as variáveis direto sem passar por isso.
APP_PASSWORD_HASH=

# Opcional: segundo hash só para automação de testes (Playwright) rodando LOCAL.
# Gere com o mesmo script, com uma senha diferente da real (mesmo aviso de "\$" acima).
# Nunca é aceito em produção na Vercel, mesmo que essa variável seja configurada lá
# por engano (o backend ignora quando detecta que está rodando na Vercel).
APP_PASSWORD_HASH_TESTE=

# String aleatória longa usada para assinar o cookie de sessão (HMAC).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# UID fixo usado no Firebase Auth e nas Firestore Security Rules (pode ser
# qualquer string estável, ex.: "owner"). Precisa ser igual nos dois lugares.
FIREBASE_OWNER_UID=

# Credenciais da Service Account do Firebase (Admin SDK). Gere em:
# Console do Firebase > Configurações do projeto > Contas de serviço > Gerar nova chave privada
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
